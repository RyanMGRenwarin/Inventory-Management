@using InventoryManagement.Web.ViewModels.Warehouse
@model WarehouseCreateViewModel

@{
    ViewData["Title"] = "Create Warehouse";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Create Warehouse</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Warehouse.Name" class="form-label"></label>
                <input asp-for="Warehouse.Name" class="form-control" placeholder="Enter warehouse name" />
                <span asp-validation-for="Warehouse.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Warehouse.Location" class="form-label"></label>
                <input asp-for="Warehouse.Location" class="form-control" placeholder="Enter location" />
                <span asp-validation-for="Warehouse.Location" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Warehouse.Capacity" class="form-label"></label>
                <input asp-for="Warehouse.Capacity" class="form-control" placeholder="Enter capacity" />
                <span asp-validation-for="Warehouse.Capacity" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Create
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
