@using InventoryManagement.Web.ViewModels.Product
@model ProductListViewModel

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Product
        </a>
    }
</div>

<!-- Filter -->
<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name or SKU" value="@Model.Filter.SearchTerm" />
            </div>
            <div class="col-md-2">
                <select name="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.Filter.CategoryId))">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="LowStockOnly" class="form-select">
                    <option value="">All Stock</option>
                    <option value="true" selected="@(Model.Filter.LowStockOnly == true)">Low Stock Only</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="number" name="MinPrice" class="form-control" placeholder="Min Price" value="@Model.Filter.MinPrice" />
            </div>
            <div class="col-md-2">
                <input type="number" name="MaxPrice" class="form-control" placeholder="Max Price" value="@Model.Filter.MaxPrice" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Product List -->
@if (Model.Products.Products.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products.Products)
                {
                    <tr>
                        <td><code>@product.SKU</code></td>
                        <td>@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.StockQuantity</td>
                        <td>
                            @if (product.StockQuantity <= product.MinimumStockThreshold)
                            {
                                <span class="badge bg-danger">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                        </td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Delete</a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">View Only</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <nav aria-label="Product pagination">
        <ul class="pagination justify-content-center">
            @if (Model.Products.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Products.PageNumber - 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-lowStockOnly="@Model.Filter.LowStockOnly">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Previous</span></li>
            }

            @for (int i = 1; i <= Model.Products.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Products.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-lowStockOnly="@Model.Filter.LowStockOnly">@i</a>
                </li>
            }

            @if (Model.Products.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Products.PageNumber + 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-lowStockOnly="@Model.Filter.LowStockOnly">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Next</span></li>
            }
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info">No products found.</div>
}
