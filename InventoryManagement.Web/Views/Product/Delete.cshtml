@using InventoryManagement.Web.ViewModels.Product
@model ProductDeleteViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Delete Product</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <strong>Are you sure you want to delete this product?</strong> This action cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Product.Name</dd>

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9"><code>@Model.Product.SKU</code></dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Product.CategoryName</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@Model.Product.Price.ToString("C")</dd>

            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.Product.StockQuantity</dd>
        </dl>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Product.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Product.Id" />
            <div class="mt-3">
                <button type="submit" class="btn btn-danger delete-btn"
                        data-title="Confirm Delete"
                        data-text="Are you sure you want to permanently delete this product?">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
