@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Inventory Management</h1>
    <p class="lead">Manage your products, warehouses, and transactions efficiently.</p>
    <hr />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Products</h5>
                        <p class="card-text">Manage your product catalog</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">View Products</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Warehouses</h5>
                        <p class="card-text">Manage warehouse locations</p>
                        <a asp-controller="Warehouse" asp-action="Index" class="btn btn-success">View Warehouses</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Transactions</h5>
                        <p class="card-text">Track inventory movements</p>
                        <a asp-controller="Transaction" asp-action="Index" class="btn btn-info">View Transactions</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Categories</h5>
                        <p class="card-text">Organize your products</p>
                        <a asp-controller="Category" asp-action="Index" class="btn btn-warning">View Categories</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <h4>Welcome!</h4>
            <p>Please <a asp-area="Auth" asp-controller="Auth" asp-action="Login">login</a> to access the inventory management system.</p>
        </div>
    }
</div>
