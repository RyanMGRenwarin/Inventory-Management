@using InventoryManagement.Web.ViewModels.Transaction
@model TransactionCreateViewModel

@{
    ViewData["Title"] = "Create Transaction";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Create Transaction</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Transaction.ProductId" class="form-label"></label>
                        <select asp-for="Transaction.ProductId" class="form-select" asp-items="@(new SelectList(Model.Products, "Id", "Name"))">
                            <option value="">Select Product</option>
                        </select>
                        <span asp-validation-for="Transaction.ProductId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Transaction.WarehouseId" class="form-label"></label>
                        <select asp-for="Transaction.WarehouseId" class="form-select" asp-items="@(new SelectList(Model.Warehouses, "Id", "Name"))">
                            <option value="">Select Warehouse</option>
                        </select>
                        <span asp-validation-for="Transaction.WarehouseId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Transaction.Type" class="form-label"></label>
                        <select asp-for="Transaction.Type" class="form-select">
                            <option value="1">Inbound</option>
                            <option value="2">Outbound</option>
                        </select>
                        <span asp-validation-for="Transaction.Type" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Transaction.Quantity" class="form-label"></label>
                        <input asp-for="Transaction.Quantity" class="form-control" placeholder="0" />
                        <span asp-validation-for="Transaction.Quantity" class="text-danger"></span>
                    </div>
                </div
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Transaction.UnitPrice" class="form-label"></label>
                        <input asp-for="UnitPriceRaw" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="UnitPriceRaw" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Transaction.Notes" class="form-label"></label>
                <textarea asp-for="Transaction.Notes" class="form-control" rows="3" placeholder="Enter notes (optional)"></textarea>
                <span asp-validation-for="Transaction.Notes" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Create
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
