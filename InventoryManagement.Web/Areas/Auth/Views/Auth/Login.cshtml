@using InventoryManagement.Application.DTOs.Auth
@model LoginRequestDto

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <h5>Welcome Back!</h5>
    <p class="text-muted">Please login to your account</p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    TempData.Remove("SuccessMessage");
}

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" placeholder="Enter username" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" placeholder="Enter password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary btn-lg">Login</button>
    </div>

    <div class="mt-3 text-center">
        <a asp-action="ForgotPassword" class="text-decoration-none">Forgot Password?</a>
        <span class="mx-2">|</span>
        <a asp-action="Register" class="text-decoration-none">Create Account</a>
    </div>
    <div class="mt-3 text-center">
        <a href="/" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}